# Saytingizning ochiq HTTPS manzili (lokal test uchun ngrok / cloudflared manzili)
APP_URL=https://your-domain.com
APP_NAME=AvtoJavob

# Uzun tasodifiy satr: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Token shifrlash kaliti: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# SQLite (dev) yoki PostgreSQL: postgresql+psycopg://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./data.db

# Meta App -> Instagram -> "API setup with Instagram login" bo'limidagi qiymatlar
IG_APP_ID=
IG_APP_SECRET=
# (ixtiyoriy) asosiy Facebook App secret - webhook imzosini tekshirishda zaxira sifatida
FB_APP_SECRET=

# Webhook sozlashda Meta'ga o'zingiz yozadigan ixtiyoriy so'z
WEBHOOK_VERIFY_TOKEN=change-me-too

GRAPH_VERSION=v23.0
# Bitta akkaunt uchun soatiga maksimal avtomatik yuborishlar
HOURLY_SEND_LIMIT=180
